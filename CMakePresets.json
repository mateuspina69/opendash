{
  "version": 6,
  "configurePresets": [
    {
      "name": "vs2026",
      "displayName": "VS 2026 x64 + vcpkg",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "environment": {
        "VCPKG_ROOT": "C:/Program Files/Microsoft Visual Studio/18/Community/VC/vcpkg"
      },
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "linux",
      "displayName": "Linux, Ninja Multi-Config + the system's packages",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build-linux",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "linux-vcpkg",
      "inherits": "linux",
      "displayName": "Linux, Ninja Multi-Config + vcpkg",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "vs2026", "configuration": "Debug" },
    { "name": "release", "configurePreset": "vs2026", "configuration": "Release" },
    { "name": "linux-debug", "configurePreset": "linux", "configuration": "Debug" },
    { "name": "linux-release", "configurePreset": "linux", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "debug", "configurePreset": "vs2026", "configuration": "Debug",
      "output": { "outputOnFailure": true } },
    { "name": "linux-debug", "configurePreset": "linux", "configuration": "Debug",
      "output": { "outputOnFailure": true } }
  ]
}
