# The OpenDash build id (src/app/build_id.hpp) written into OUT on every build, rewritten only when it changed.
# Netplay's handshake refuses a player whose build id differs from the host's, so the id covers exactly what makes two
# instances incompatible: the code of the game state, the content scripts, the data loading and the wire (kNetPaths).
# Rendering, upscalers, UI and tools are left out -- builds that differ only there play together.
# It is a content hash, not a commit: the SHA-1 of every file's path and git blob id (`git hash-object`, line endings
# normalised as git stores them), tracked or untracked, committed or not. The same sources give the same id in any
# clone or repository, whatever its history.
#   cmake -DGIT=<git> -DSRC=<source dir> -DOUT=<file.cpp> -P build_id.cmake
set(kNetPaths src/game src/content src/engine src/net src/app/netplay.cpp src/app/netplay.hpp)

execute_process(COMMAND "${GIT}" -C "${SRC}" ls-files --cached --others --exclude-standard --deduplicate -- ${kNetPaths}
                OUTPUT_VARIABLE listed OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "build id: git ls-files failed in ${SRC} (${rc})")
endif()
string(REPLACE "\n" ";" listed "${listed}")
set(files "")
foreach(f IN LISTS listed)
    if(EXISTS "${SRC}/${f}") # a tracked file deleted locally is not part of the build
        list(APPEND files "${f}")
    endif()
endforeach()
list(SORT files)
if(NOT files)
    message(FATAL_ERROR "build id: no sources under ${kNetPaths} in ${SRC}")
endif()
# hash-object reads --stdin-paths from the repository's top level, and SRC may be a subdirectory of it
execute_process(COMMAND "${GIT}" -C "${SRC}" rev-parse --show-toplevel --show-prefix
                OUTPUT_VARIABLE where OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "build id: git rev-parse failed in ${SRC} (${rc})")
endif()
string(REPLACE "\n" ";" where "${where}")
list(GET where 0 top)
set(prefix "")
list(LENGTH where n)
if(n GREATER 1)
    list(GET where 1 prefix)
endif()
list(TRANSFORM files PREPEND "${prefix}" OUTPUT_VARIABLE fromTop)
string(REPLACE ";" "\n" paths "${fromTop}")
set(pathsFile "${OUT}.paths")
file(WRITE "${pathsFile}" "${paths}\n")
execute_process(COMMAND "${GIT}" hash-object --stdin-paths WORKING_DIRECTORY "${top}" INPUT_FILE "${pathsFile}"
                OUTPUT_VARIABLE blobs OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE rc)
file(REMOVE "${pathsFile}")
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "build id: git hash-object failed in ${SRC} (${rc})")
endif()
string(REPLACE "\n" ";" blobs "${blobs}")
set(manifest "")
foreach(f b IN ZIP_LISTS files blobs)
    string(APPEND manifest "${b} ${f}\n")
endforeach()
string(SHA1 id "${manifest}")
string(SUBSTRING "${id}" 0 12 id)

set(text "// generated by cmake/build_id.cmake on every build\n#include \"app/build_id.hpp\"\n\nnamespace od::app {\nconst char* buildId() { return \"${id}\"; }\n} // namespace od::app\n")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL text)
    file(WRITE "${OUT}" "${text}")
endif()
